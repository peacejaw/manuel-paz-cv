---
import GitHub from "@/icons/GitHub.astro"
import Section from "../Section.astro"

import { getCV, useTranslations, type Lang } from "@/i18n"

const { lang } = Astro.props as { lang: Lang }
const { projects } = getCV(lang)
const t = useTranslations(lang)
---

<Section title={t("projects.title")}>
  <ul class="projects">
    {
      projects.map(
        ({ url, description, highlights, name, isActive, github, caseId, period }) => (
          <li>
            <article>
              <header>
                <h3>
                {caseId ? <button class="project-detail" type="button" data-case={caseId} aria-haspopup="dialog" aria-controls={`case-${caseId}`}>{name}<span class="no-print" aria-hidden="true"> +</span></button> : <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={t("projects.link", { name })}
                >
                  {name}
                </a>}
                {isActive && (
                  <span
                    class="live"
                    role="img"
                    title={t("projects.active")}
                    aria-label={t("projects.active")}
                  />
                )}
                {github && (
                  <a
                    class="source no-print"
                    href={github}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={t("projects.source", { name })}
                    aria-label={t("projects.source", { name })}
                  >
                    <GitHub />
                  </a>
                )}
                </h3>
                <p class="project-dates">{period}</p>
              </header>
              <p>{description}</p>
              <ul class="highlights">
                {highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </article>
          </li>
        )
      )
    }
  </ul>
</Section>

<style>
  .projects {
    display: grid;
    gap: 1.75rem;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .25rem 1rem;
  }

  .project-dates {
    flex: none;
    margin: 0;
    color: var(--color-muted);
    font-size: .875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media screen and (width <= 520px) {
    header { flex-wrap: wrap; }
  }

  @media print {
    header { flex-wrap: wrap; }
  }

  h3 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }

  h3 a:hover {
    text-decoration-color: var(--color-accent);
  }

  .project-detail { padding: 0; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; text-align: left; text-decoration: underline; text-decoration-color: #bfc1c6; text-underline-offset: .22em; }
  .project-detail:hover { text-decoration-color: currentColor; }
  .project-detail span { color: var(--color-muted); font-weight: 400; margin-left: .25rem; }
  @media print { .project-detail { text-decoration: none; } }

  .live {
    width: 0.4375rem;
    height: 0.4375rem;
    background: var(--color-live);
    border-radius: 50%;
  }

  .source {
    margin-left: auto;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .source:hover {
    color: var(--color-ink);
  }

  .source :global(svg) {
    width: 0.9375rem;
    height: 0.9375rem;
  }

  p {
    max-width: var(--content-col);
    margin-top: 0.125rem;
    font-size: 0.9375rem;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.625rem;
  }

  .highlights li {
    padding: 0.0625rem 0.5rem;
    color: var(--color-text);
    background: var(--color-wash);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5rem;
  }

  @media print {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.5rem;
    }

    .highlights {
      gap: 0.25rem;
      margin-top: 0.375rem;
    }

    .highlights li {
      padding: 0 0.375rem;
      background: none;
      border: 1px solid var(--color-rule);
      line-height: 1.25rem;
    }
  }
</style>
